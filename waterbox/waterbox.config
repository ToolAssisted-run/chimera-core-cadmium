{
 "coreName": "Cadmium",
 "systemId": "CHIP8",
 "systemNames": {
  "CHIP8": "CHIP-8"
 },
 "author": "Steffen Sch\u00fcmann (Cadmium); chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-cadmium",
 "romFile": "rom",
 "deterministic": true,
 "memoryLayoutMiB": [
  64,
  4,
  8,
  4,
  128
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. A CHIP-8 has 4 KiB of memory and the biggest of these machines, MegaChip, has 16 MiB; the rest is room for Cadmium's own tables and for compiling a program given as source.",
 "video": {
  "_comment": "width and height are the biggest picture any of the machines makes; the size of the picture in front of you comes from the core every frame. A CHIP-8 picture is 64x32 dots, a SUPER-CHIP or XO-CHIP one 128x64, the COSMAC VIP's taller modes 64x64 and 64x128 with flatter dots - all twice as wide as they are high on a television, which is what virtualWidth and virtualHeight say. MegaChip's 256x192 is given black borders left and right (384x192) to be the same shape. 60 frames a second, except 64 for the HP-48 calculators' variants (CHIP-48, SUPER-CHIP 1.0 and 1.1) and 50 for MegaChip and the DREAM 6800: the core says which.",
  "width": 384,
  "height": 192,
  "virtualWidth": 512,
  "virtualHeight": 256,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1,
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "One channel at 48000 samples a second, made by Cadmium from the machine's sound timer (and from the program's own sound pattern, for XO-CHIP and MegaChip): 800 samples a frame at 60 frames a second, 750 at 64, 960 at 50.",
  "rate": 48000,
  "samplesPerFrame": 2048,
  "channels": 1,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "extensions": {
  ".ch8": "CHIP8",
  ".sc8": "CHIP8",
  ".xo8": "CHIP8",
  ".mc8": "CHIP8",
  ".ch10": "CHIP8",
  ".c8x": "CHIP8",
  ".c8e": "CHIP8",
  ".hc8": "CHIP8",
  ".c8tp": "CHIP8",
  ".c8b": "CHIP8",
  ".8o": "CHIP8"
 },
 "input": {
  "name": "CHIP-8 Keypad",
  "_comment": "The sixteen keys of the hexadecimal keypad every CHIP-8 machine has, 0 to F. On the COSMAC VIP they sit in four rows: 1 2 3 C, 4 5 6 D, 7 8 9 E, A 0 B F.",
  "buttons": [
   "Key 0",
   "Key 1",
